# #
# Marketing / tracking query params IGNORED by the FastCGI page cache.
#
#   /about-us/?gclid=123&utm_source=x   -> served from the cache of /about-us/
#   /about-us/?gclid=123&page=2         -> still bypasses the cache (page=2 is a real param)
#
# The params are NOT removed from the visitor's URL (no redirect), so GA4,
# Google Ads, Meta Pixel etc. still read them in the browser.
# On cacheable requests PHP does NOT see these params (same as on a cache HIT):
# do NOT list a param that a plugin reads server-side in PHP (see bottom).
#
# Syntax (nginx map entries, one per line, ";" at the end):
#   gclid 1;            exact param name (case-insensitive)
#   ~*^utm_ 1;          regex on the param name (here: every utm_* param);
#                       ~* = case-insensitive, ~ = case-sensitive
#
# File: /etc/nginx/marketing-params/params.list
# After editing:  nginx -t && systemctl reload nginx     (or: gp ngx reload)
# #

# --- Google Analytics / Ads / Merchant Center
~*^utm_ 1;
~*^gad_ 1;
gclid 1;
gclsrc 1;
dclid 1;
gbraid 1;
wbraid 1;
gadid 1;
srsltid 1;
campaignid 1;
adgroupid 1;
_gl 1;
_ga 1;
usqp 1;

# --- Meta / Facebook / Instagram
fbclid 1;
fbadid 1;
fb_action_ids 1;
fb_action_types 1;
fb_source 1;
igshid 1;

# --- Microsoft Ads
msclkid 1;

# --- TikTok, X, LinkedIn, Snapchat, Reddit, Pinterest, Yandex
ttclid 1;
twclid 1;
li_fat_id 1;
sccid 1;
rdt_cid 1;
epik 1;
yclid 1;
ysclid 1;
_openstat 1;

# --- Adobe, Marin
ef_id 1;
s_kwcid 1;
mkwid 1;
pcrid 1;

# --- Matomo / Piwik Pro
~*^mtm_ 1;
pk_source 1;
pk_medium 1;
pk_campaign 1;
pk_keyword 1;
pk_cid 1;
pk_content 1;

# --- HubSpot
~*^hsa_ 1;
_hsenc 1;
_hsmi 1;
__hstc 1;
__hssc 1;
__hsfp 1;
hsctatracking 1;

# --- E-mail / CRM (Klaviyo, Marketo, Kit, Drip, ActiveCampaign, Bronto,
#     Dotdigital, Listrak, Salesforce MC, Brevo, Omeda, Vero, Wicked Reports)
_kx 1;
_ke 1;
mkt_tok 1;
__s 1;
vgo_ee 1;
_bta_tid 1;
_bta_c 1;
dm_i 1;
trk_contact 1;
trk_msg 1;
trk_module 1;
trk_sid 1;
sfmc_id 1;
sfmc_activityid 1;
_sc 1;
_se 1;
oly_anon_id 1;
oly_enc_id 1;
vero_id 1;
vero_conv 1;
wickedid 1;

# --- Feeds / affiliate (only ones read in JS, not PHP)
gdfms 1;
gdftrk 1;
gdffi 1;
redirect_log_mongo_id 1;
redirect_mongo_id 1;
sb_referer_host 1;
sscid 1;

# #
# OPTIONAL - enable only after checking the site:
#
# Mailchimp for WooCommerce reads these in PHP ($_GET) to set the
# mailchimp_email_id / mailchimp_campaign_id cookies. If they are ignored here,
# cached pages won't set those cookies (mc_cid order attribution still works
# via WooCommerce Order Attribution, mc_eid subscriber matching does not).
#mc_cid 1;
#mc_eid 1;
#
# Kit (ConvertKit) plugin reads ck_subscriber_id in PHP to set its subscriber cookie:
#ck_subscriber_id 1;
#
# Generic names that may collide with other plugins:
#adid 1;
#gad 1;
#
# NEVER add (they change what the server renders): ref (AffiliateWP),
# cn-reloaded (Cookie Notice), age-verified, ao_noptimize, s, p, page_id,
# paged, lang, v, preview, add-to-cart, mc_cart_id, irclickid, cjevent, awc ...
# #
